<Window x:Class="AViewer.App.FocusRingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1"
        Height="1"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False">
  <Border x:Name="RingBorder" BorderBrush="#FF0067C0"
          BorderThickness="4"
          CornerRadius="2"
          Background="Transparent"/>
</Window>
