<Window x:Class="AViewer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:AViewer.Core.Models;assembly=AViewer.Core"
        Title="AViewer Modern"
        AutomationProperties.Name="AViewer accessibility inspector"
        Width="1080" Height="680" MinWidth="760" MinHeight="480"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
  <DockPanel Margin="8">
    <Border DockPanel.Dock="Top"
            Padding="0,0,0,2"
            Margin="0,0,0,4"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
            BorderThickness="0,0,0,1">
      <WrapPanel Orientation="Horizontal">
        <Button x:Name="InspectPointerButton"
                Content="_Inspect pointer"
                Click="InspectPointer_Click"
                ToolTip="Continuously inspect elements under the pointer outside AViewer"/>
        <Button x:Name="InspectFocusButton"
                Content="Inspect _focus"
                Click="InspectFocus_Click"
                ToolTip="Continuously inspect keyboard focus outside AViewer"/>
        <Button Content="_Copy JSON" Click="CopyJson_Click"/>
        <Button Content="_Save JSON…" Click="SaveJson_Click"/>
        <Button Content="_Properties…"
                Click="ChooseProperties_Click"
                ToolTip="Choose which accessibility properties are displayed"/>

        <Separator Width="1" Margin="3,2,8,6"/>

        <CheckBox x:Name="ShowRelationshipsCheckBox"
                  Content="_Relationships"
                  ToolTip="Draw labelled connectors to related accessibility elements"
                  Checked="ShowRelationships_Changed"
                  Unchecked="ShowRelationships_Changed"/>
        <Button x:Name="RecordFocusOrderButton"
                Content="_Record focus order"
                Click="RecordFocusOrder_Click"
                ToolTip="Record Tab and Shift+Tab focus stops outside AViewer"/>
        <Button Content="C_lear path"
                Click="ClearFocusPath_Click"
                ToolTip="Clear the recorded focus-order visualization"/>
        <CheckBox x:Name="IncludeArrowNavigationCheckBox"
                  Content="_Arrow navigation"
                  ToolTip="Also record focus changes caused by arrow keys inside composite widgets"
                  Checked="IncludeArrowNavigation_Changed"
                  Unchecked="IncludeArrowNavigation_Changed"/>
        <CheckBox x:Name="AlwaysOnTopCheckBox"
                  Content="Always on _top"
                  Checked="AlwaysOnTop_Changed"
                  Unchecked="AlwaysOnTop_Changed"/>

        <TextBlock Margin="2,5,4,0" Text="Depth:" VerticalAlignment="Top"/>
        <ComboBox x:Name="DepthBox" Width="54" SelectedIndex="2">
          <ComboBoxItem Content="0"/>
          <ComboBoxItem Content="1"/>
          <ComboBoxItem Content="2"/>
          <ComboBoxItem Content="3"/>
          <ComboBoxItem Content="4"/>
        </ComboBox>
      </WrapPanel>
    </Border>

    <StatusBar DockPanel.Dock="Bottom" Margin="0,4,0,0" Padding="2,0" MinHeight="24">
      <StatusBarItem Padding="2,0">
        <TextBlock x:Name="StatusText" Text="Ready"/>
      </StatusBarItem>
    </StatusBar>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*" MinWidth="250"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="7*" MinWidth="330"/>
      </Grid.ColumnDefinitions>

      <GroupBox x:Name="TreeGroupBox" Header="UIA accessibility tree" Grid.Column="0">
        <TreeView x:Name="NodeTree"
                  Padding="2"
                  SelectedItemChanged="NodeTree_SelectedItemChanged">
          <TreeView.Resources>
            <HierarchicalDataTemplate DataType="{x:Type models:AccessibilityNode}" ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal" Margin="0,1">
                <TextBlock FontWeight="SemiBold" Text="{Binding ControlType}"/>
                <TextBlock Text=" — "/>
                <TextBlock Text="{Binding Name}"/>
              </StackPanel>
            </HierarchicalDataTemplate>
          </TreeView.Resources>
        </TreeView>
      </GroupBox>

      <GridSplitter Grid.Column="1"
                    Width="4"
                    Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                    HorizontalAlignment="Stretch"/>

      <GroupBox Header="Properties" Grid.Column="2">
        <GroupBox.Resources>
          <Style x:Key="WrappingCellText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Padding" Value="4,2"/>
          </Style>
          <Style x:Key="PropertyDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
          </Style>
        </GroupBox.Resources>

        <TabControl x:Name="ApiTabControl"
                    Padding="0"
                    SelectionChanged="ApiTabControl_SelectionChanged">
          <TabItem Header="UIA">
            <DataGrid x:Name="UiaPropertyGrid" Style="{StaticResource PropertyDataGrid}">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Section" Width="110">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Style="{StaticResource WrappingCellText}" Text="{Binding Group}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Property" Width="145">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Style="{StaticResource WrappingCellText}" Text="{Binding Name}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Value" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Style="{StaticResource WrappingCellText}" Text="{Binding Value}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>

          <TabItem Header="MSAA">
            <DataGrid x:Name="MsaaPropertyGrid" Style="{StaticResource PropertyDataGrid}">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Property" Width="145">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Style="{StaticResource WrappingCellText}" Text="{Binding Name}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Value" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Style="{StaticResource WrappingCellText}" Text="{Binding Value}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>

          <TabItem Header="IAccessible2">
            <DataGrid x:Name="Ia2PropertyGrid" Style="{StaticResource PropertyDataGrid}">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Property" Width="145">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Style="{StaticResource WrappingCellText}" Text="{Binding Name}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Value" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Style="{StaticResource WrappingCellText}" Text="{Binding Value}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
        </TabControl>
      </GroupBox>
    </Grid>
  </DockPanel>
</Window>
