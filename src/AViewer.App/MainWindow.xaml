<Window x:Class="AViewer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:AViewer.Core.Models;assembly=AViewer.Core"
        Title="AViewer Modern"
        AutomationProperties.Name="AViewer accessibility inspector"
        Width="1280" Height="820" MinWidth="900" MinHeight="600" PreviewKeyDown="MainWindow_PreviewKeyDown">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
      <Button x:Name="InspectPointerButton" Content="_Inspect pointer" Click="InspectPointer_Click" ToolTip="Continuously inspect elements under the pointer outside AViewer"/>
      <Button x:Name="InspectFocusButton" Content="Inspect _focus" Click="InspectFocus_Click" ToolTip="Continuously inspect keyboard focus outside AViewer"/>
      <Button Content="_Copy JSON" Click="CopyJson_Click"/>
      <Button Content="_Save JSON…" Click="SaveJson_Click"/>
      <Button Content="Choose _properties…" Click="ChooseProperties_Click" ToolTip="Choose which accessibility properties are displayed"/>
      <CheckBox x:Name="ShowRelationshipsCheckBox"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Content="Show _relationships"
                ToolTip="Draw labelled connectors to related UIA elements"
                Checked="ShowRelationships_Changed"
                Unchecked="ShowRelationships_Changed"/>
      <Button x:Name="RecordFocusOrderButton"
              Margin="16,0,0,0"
              Content="_Record focus order"
              Click="RecordFocusOrder_Click"
              ToolTip="Record Tab and Shift+Tab focus stops outside AViewer"/>
      <Button Content="C_lear focus path"
              Click="ClearFocusPath_Click"
              ToolTip="Clear the recorded focus-order visualization"/>
      <CheckBox x:Name="IncludeArrowNavigationCheckBox"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                Content="Include _arrow navigation"
                ToolTip="Also record focus changes caused by arrow keys inside composite widgets"
                Checked="IncludeArrowNavigation_Changed"
                Unchecked="IncludeArrowNavigation_Changed"/>
      <CheckBox x:Name="AlwaysOnTopCheckBox"
                Margin="16,0,0,0"
                VerticalAlignment="Center"
                Content="Always on _top"
                Checked="AlwaysOnTop_Changed"
                Unchecked="AlwaysOnTop_Changed"/>
      <TextBlock Margin="12,8,0,0" Text="Depth:"/>
      <ComboBox x:Name="DepthBox" Width="64" SelectedIndex="2" Margin="6,0,0,0">
        <ComboBoxItem Content="0"/><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/>
      </ComboBox>
    </StackPanel>

    <StatusBar DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <StatusBarItem><TextBlock x:Name="StatusText" Text="Ready"/></StatusBarItem>
    </StatusBar>

    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
      <GroupBox x:Name="TreeGroupBox" Header="UIA accessibility tree" Grid.Column="0" Padding="8">
        <TreeView x:Name="NodeTree" SelectedItemChanged="NodeTree_SelectedItemChanged">
          <TreeView.Resources>
            <HierarchicalDataTemplate DataType="{x:Type models:AccessibilityNode}" ItemsSource="{Binding Children}">
              <StackPanel Orientation="Horizontal">
                <TextBlock FontWeight="SemiBold" Text="{Binding ControlType}"/>
                <TextBlock Text=" — "/>
                <TextBlock Text="{Binding Name}"/>
              </StackPanel>
            </HierarchicalDataTemplate>
          </TreeView.Resources>
        </TreeView>
      </GroupBox>
      <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
      <GroupBox Header="Properties" Grid.Column="2" Padding="8">
        <GroupBox.Resources>
          <Style x:Key="WrappingCellText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Padding" Value="4,3"/>
          </Style>
          <Style x:Key="PropertyDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
          </Style>
        </GroupBox.Resources>
        <TabControl x:Name="ApiTabControl" SelectionChanged="ApiTabControl_SelectionChanged">
          <TabItem Header="UIA">
            <DataGrid x:Name="UiaPropertyGrid" Style="{StaticResource PropertyDataGrid}">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Section" Width="135">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Style="{StaticResource WrappingCellText}" Text="{Binding Group}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Property" Width="180">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Style="{StaticResource WrappingCellText}" Text="{Binding Name}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Value" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Style="{StaticResource WrappingCellText}" Text="{Binding Value}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="MSAA">
            <DataGrid x:Name="MsaaPropertyGrid" Style="{StaticResource PropertyDataGrid}">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Property" Width="180">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Style="{StaticResource WrappingCellText}" Text="{Binding Name}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Value" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Style="{StaticResource WrappingCellText}" Text="{Binding Value}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
          <TabItem Header="IAccessible2">
            <DataGrid x:Name="Ia2PropertyGrid" Style="{StaticResource PropertyDataGrid}">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Property" Width="180">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Style="{StaticResource WrappingCellText}" Text="{Binding Name}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Value" Width="*">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <TextBlock Style="{StaticResource WrappingCellText}" Text="{Binding Value}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
          </TabItem>
        </TabControl>
      </GroupBox>
    </Grid>
  </DockPanel>
</Window>
