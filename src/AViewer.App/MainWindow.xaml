<Window x:Class="AViewer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:AViewer.Core.Models;assembly=AViewer.Core"
        Title="AViewer Moderno"
        AutomationProperties.Name="AViewer Moderno accessibility inspector"
        Width="1080" Height="700" MinWidth="760" MinHeight="480"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
  <Window.Resources>
    <HierarchicalDataTemplate DataType="{x:Type models:AccessibilityNode}" ItemsSource="{Binding Children}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{Binding ControlType}" FontWeight="SemiBold"/>
        <TextBlock Text="  "/>
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </HierarchicalDataTemplate>
    <DataTemplate x:Key="WrappedCellTemplate">
      <TextBlock Text="{Binding Value}" TextWrapping="Wrap" Margin="5,3"/>
    </DataTemplate>

    <Style x:Key="InspectSwitchStyle" TargetType="{x:Type ToggleButton}">
      <Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ToggleButton}">
            <Border x:Name="FocusBorder"
                    Padding="2"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="1">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid Width="36" Height="20" Margin="0,0,6,0">
                  <Border x:Name="SwitchTrack"
                          CornerRadius="10"
                          Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                          BorderBrush="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                          BorderThickness="1"/>
                  <Ellipse x:Name="SwitchThumb"
                           Width="14" Height="14" Margin="3"
                           HorizontalAlignment="Left"
                           Fill="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                           Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
                           StrokeThickness="1"/>
                </Grid>
                <ContentPresenter ContentSource="Content"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True"/>
              </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="SwitchTrack" Property="Background"
                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                <Setter TargetName="SwitchThumb" Property="Fill"
                        Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusBorder" Property="BorderBrush"
                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="SwitchTrack" Property="BorderBrush"
                        Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="0"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            MinHeight="28"
            Panel.ZIndex="100"
            Visibility="Visible"
            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
            BorderThickness="0,0,0,1">
      <Menu x:Name="MainMenu"
            MinHeight="27"
            Visibility="Visible"
            VerticalAlignment="Stretch"
            Background="Transparent"
            Foreground="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}"
            AutomationProperties.Name="Application menu">
      <MenuItem Header="_File">
        <MenuItem Header="Copy selected element as _HTML" Click="CopyHtml_Click" InputGestureText="Ctrl+Shift+H"/>
        <MenuItem Header="Copy loaded HTML _subtree" Click="CopyHtmlSubtree_Click"/>
        <Separator/>
        <MenuItem Header="_Copy accessibility tree as JSON" Click="CopyJson_Click" InputGestureText="Ctrl+C"/>
        <MenuItem Header="_Save accessibility tree as JSON…" Click="SaveJson_Click" InputGestureText="Ctrl+S"/>
        <Separator/>
        <MenuItem Header="E_xit" Click="Exit_Click"/>
      </MenuItem>

      <MenuItem Header="_Inspect">
        <MenuItem x:Name="InspectPointerButton"
                  Header="Inspect by _pointer"
                  IsCheckable="True"
                  StaysOpenOnClick="True"
                  Click="InspectPointer_Click"
                  InputGestureText="F7"/>
        <MenuItem x:Name="InspectFocusButton"
                  Header="Inspect keyboard _focus"
                  IsCheckable="True"
                  StaysOpenOnClick="True"
                  Click="InspectFocus_Click"
                  InputGestureText="F8"/>
        <Separator/>
        <MenuItem x:Name="RecordFocusOrderButton"
                  Header="_Record focus order"
                  Click="RecordFocusOrder_Click"
                  InputGestureText="F9"/>
        <MenuItem Header="C_lear focus path" Click="ClearFocusPath_Click"/>
        <MenuItem x:Name="IncludeArrowNavigationCheckBox"
                  Header="Include _arrow-key navigation"
                  IsCheckable="True"
                  Checked="IncludeArrowNavigation_Changed"
                  Unchecked="IncludeArrowNavigation_Changed"/>
      </MenuItem>

      <MenuItem Header="_View">
        <MenuItem x:Name="ShowRelationshipsCheckBox"
                  Header="Show _relationships"
                  IsCheckable="True"
                  Checked="ShowRelationships_Changed"
                  Unchecked="ShowRelationships_Changed"/>
        <MenuItem x:Name="AlwaysOnTopCheckBox"
                  Header="Always on _top"
                  IsCheckable="True"
                  Checked="AlwaysOnTop_Changed"
                  Unchecked="AlwaysOnTop_Changed"/>
        <Separator/>
        <MenuItem Header="_Preferences…" Click="ChooseProperties_Click"/>
      </MenuItem>

      <MenuItem Header="_Navigate">
        <MenuItem Header="Load complete _app or page tree" Click="LoadCompleteTree_Click" InputGestureText="Ctrl+Shift+A"/>
        <Separator/>
        <MenuItem Header="_Up one level" Click="UpOneLevel_Click" InputGestureText="Alt+Up"/>
        <MenuItem Header="_Expand complete tree" Click="ExpandAll_Click"/>
        <MenuItem Header="_Collapse tree" Click="CollapseAll_Click"/>
      </MenuItem>

      <MenuItem x:Name="HelpMenu" Header="_Help"/>
      </Menu>
    </Border>

    <Border Grid.Row="1"
            Padding="8,5"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
            BorderThickness="0,0,0,1"
            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
      <DockPanel LastChildFill="False">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <ToggleButton x:Name="PointerToolbarButton"
                        Style="{StaticResource InspectSwitchStyle}"
                        Content="Pointer inspect"
                        Click="InspectPointer_Click"
                        AutomationProperties.Name="Pointer inspection switch"
                        ToolTip="Continuously inspect the element under the pointer (F7)"/>
          <ToggleButton x:Name="FocusToolbarButton"
                        Style="{StaticResource InspectSwitchStyle}"
                        Content="Focus inspect"
                        Click="InspectFocus_Click"
                        AutomationProperties.Name="Keyboard focus inspection switch"
                        ToolTip="Continuously inspect keyboard focus (F8)"/>
          <Button x:Name="FocusOrderToolbarButton"
                  Content="Focus _order"
                  Click="RecordFocusOrder_Click"
                  ToolTip="Record Tab and arrow-key focus navigation (F9)"/>
          <Separator Width="1" Margin="6,2"/>
          <Button Content="Complete _tree"
                  Click="LoadCompleteTree_Click"
                  ToolTip="Load the complete accessibility tree for the selected application or web page"/>
          <Button Content="_Up one level" Click="UpOneLevel_Click"/>
          <Button Content="_Preferences…" Click="ChooseProperties_Click"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
          <TextBlock Text="Tree depth" VerticalAlignment="Center" Margin="0,0,6,0"/>
          <ComboBox x:Name="DepthBox" Width="58" SelectedIndex="2" AutomationProperties.Name="Accessibility tree depth">
            <ComboBoxItem Content="0"/>
            <ComboBoxItem Content="1"/>
            <ComboBoxItem Content="2"/>
            <ComboBoxItem Content="3"/>
            <ComboBoxItem Content="4"/>
            <ComboBoxItem Content="5"/>
            <ComboBoxItem Content="6"/>
            <ComboBoxItem Content="All"/>
          </ComboBox>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="2" Margin="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" MinWidth="260"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="3*" MinWidth="340"/>
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TreeHeading" Text="UIA accessibility tree" FontWeight="SemiBold" Margin="0,0,0,6"/>
        <TreeView x:Name="NodeTree"
                  Grid.Row="1"
                  SelectedItemChanged="NodeTree_SelectedItemChanged"
                  AutomationProperties.Name="Accessibility tree"/>
      </Grid>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>

      <TabControl x:Name="ApiTabControl"
                  Grid.Column="2"
                  SelectionChanged="ApiTabControl_SelectionChanged">
        <TabItem Header="UIA">
          <DataGrid x:Name="UiaPropertyGrid" AutomationProperties.Name="UIA properties">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="Auto"/>
              <DataGridTextColumn Header="Property" Binding="{Binding Name}" Width="Auto"/>
              <DataGridTemplateColumn Header="Value" CellTemplate="{StaticResource WrappedCellTemplate}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
        <TabItem Header="MSAA">
          <DataGrid x:Name="MsaaPropertyGrid" AutomationProperties.Name="MSAA properties">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="Auto"/>
              <DataGridTextColumn Header="Property" Binding="{Binding Name}" Width="Auto"/>
              <DataGridTemplateColumn Header="Value" CellTemplate="{StaticResource WrappedCellTemplate}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
        <TabItem Header="IAccessible2">
          <DataGrid x:Name="Ia2PropertyGrid" AutomationProperties.Name="IAccessible2 properties">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="Auto"/>
              <DataGridTextColumn Header="Property" Binding="{Binding Name}" Width="Auto"/>
              <DataGridTemplateColumn Header="Value" CellTemplate="{StaticResource WrappedCellTemplate}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
      </TabControl>
    </Grid>

    <StatusBar Grid.Row="3">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="Ready" TextWrapping="Wrap"/>
      </StatusBarItem>
    </StatusBar>
  </Grid>
</Window>
