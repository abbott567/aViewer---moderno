<Window x:Class="AViewer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:AViewer.Core.Models;assembly=AViewer.Core"
        xmlns:local="clr-namespace:AViewer.App"
        Title="{local:Loc Key=AppTitle}"
        AutomationProperties.Name="{local:Loc Key=AppAutomationName}"
        FlowDirection="{Binding FlowDirection, Source={x:Static local:LocalizationManager.Instance}}"
        Width="1080" Height="680" MinWidth="760" MinHeight="480"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*" MinHeight="0"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Menu Grid.Row="0"
          Background="{DynamicResource {x:Static SystemColors.MenuBrushKey}}"
          Foreground="{DynamicResource {x:Static SystemColors.MenuTextBrushKey}}">
      <MenuItem Header="{local:Loc Key=MenuFile}">
        <MenuItem Header="{local:Loc Key=MenuCopyHtml}"
                  Click="CopyHtml_Click"
                  InputGestureText="Ctrl+Shift+H"/>
        <MenuItem Header="{local:Loc Key=MenuCopyHtmlSubtree}"
                  Click="CopyHtmlSubtree_Click"/>
        <Separator/>
        <MenuItem Header="{local:Loc Key=MenuCopyJson}"
                  Click="CopyJson_Click"
                  InputGestureText="Ctrl+C"/>
        <MenuItem Header="{local:Loc Key=MenuSaveJson}"
                  Click="SaveJson_Click"
                  InputGestureText="Ctrl+S"/>
        <Separator/>
        <MenuItem Header="{local:Loc Key=MenuExit}" Click="Exit_Click"/>
      </MenuItem>

      <MenuItem Header="{local:Loc Key=MenuInspect}">
        <MenuItem x:Name="InspectPointerButton"
                  Header="{local:Loc Key=MenuInspectPointer}"
                  IsCheckable="True"
                  StaysOpenOnClick="True"
                  Click="InspectPointer_Click"
                  InputGestureText="F7"/>
        <MenuItem x:Name="InspectFocusButton"
                  Header="{local:Loc Key=MenuInspectFocus}"
                  IsCheckable="True"
                  StaysOpenOnClick="True"
                  Click="InspectFocus_Click"
                  InputGestureText="F8"/>
        <Separator/>
        <MenuItem x:Name="RecordFocusOrderButton"
                  Header="{local:Loc Key=MenuRecordFocusOrder}"
                  Click="RecordFocusOrder_Click"
                  InputGestureText="F9"/>
        <MenuItem Header="{local:Loc Key=MenuClearFocusPath}"
                  Click="ClearFocusPath_Click"/>
        <MenuItem x:Name="IncludeArrowNavigationCheckBox"
                  Header="{local:Loc Key=MenuIncludeArrowNavigation}"
                  IsCheckable="True"
                  Checked="IncludeArrowNavigation_Changed"
                  Unchecked="IncludeArrowNavigation_Changed"/>
      </MenuItem>

      <MenuItem Header="{local:Loc Key=MenuView}">
        <MenuItem x:Name="ShowRelationshipsCheckBox"
                  Header="{local:Loc Key=MenuShowRelationships}"
                  IsCheckable="True"
                  Checked="ShowRelationships_Changed"
                  Unchecked="ShowRelationships_Changed"/>
        <MenuItem x:Name="AlwaysOnTopCheckBox"
                  Header="{local:Loc Key=MenuAlwaysOnTop}"
                  IsCheckable="True"
                  Checked="AlwaysOnTop_Changed"
                  Unchecked="AlwaysOnTop_Changed"/>
        <Separator/>
        <MenuItem Header="{local:Loc Key=MenuChooseProperties}"
                  Click="ChooseProperties_Click"/>
        <Separator/>
        <MenuItem Header="{local:Loc Key=MenuLanguage}">
          <MenuItem x:Name="SystemLanguageMenuItem" Header="{local:Loc Key=LanguageSystem}" Tag="" IsCheckable="True" Click="Language_Click"/>
          <MenuItem x:Name="EnglishLanguageMenuItem" Header="{local:Loc Key=LanguageEnglish}" Tag="en-US" IsCheckable="True" Click="Language_Click"/>
          <MenuItem x:Name="FrenchLanguageMenuItem" Header="{local:Loc Key=LanguageFrench}" Tag="fr-FR" IsCheckable="True" Click="Language_Click"/>
        </MenuItem>
      </MenuItem>

      <MenuItem Header="{local:Loc Key=MenuNavigate}">
        <MenuItem Header="{local:Loc Key=MenuUpOneLevel}"
                  Click="UpOneLevel_Click"
                  InputGestureText="Alt+Up"/>
      </MenuItem>

      <MenuItem x:Name="HelpMenu" Header="{local:Loc Key=MenuHelp}">
        <!-- Items are loaded from HelpMenuLinks.json at runtime. -->
      </MenuItem>
    </Menu>

    <Border Grid.Row="1"
            Padding="8,5"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
            BorderThickness="0,0,0,1"
            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
      <DockPanel LastChildFill="False">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
          <ToggleButton x:Name="PointerToolbarButton"
                        Style="{StaticResource InspectionSwitchStyle}"
                        Content="{local:Loc Key=PointerInspect}"
                        Click="InspectPointer_Click"
                        AutomationProperties.Name="{local:Loc Key=PointerInspectionName}"
                        ToolTip="{local:Loc Key=PointerInspectionTooltip}"/>
          <ToggleButton x:Name="FocusToolbarButton"
                        Style="{StaticResource InspectionSwitchStyle}"
                        Content="{local:Loc Key=FocusInspect}"
                        Click="InspectFocus_Click"
                        AutomationProperties.Name="{local:Loc Key=FocusInspectionName}"
                        ToolTip="{local:Loc Key=FocusInspectionTooltip}"/>
          <Button x:Name="FocusOrderToolbarButton"
                  Content="{local:Loc Key=FocusOrder}"
                  Click="RecordFocusOrder_Click"
                  ToolTip="{local:Loc Key=FocusOrderTooltip}"/>
          <Separator Width="1" Margin="6,2"/>
          <Button Content="{local:Loc Key=MenuUpOneLevel}"
                  Click="UpOneLevel_Click"
                  ToolTip="{local:Loc Key=UpOneLevelTooltip}"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
          <TextBlock Text="{local:Loc Key=TreeDepth}"
                     VerticalAlignment="Center"
                     Margin="0,0,6,0"/>
          <ComboBox x:Name="DepthBox"
                    Width="58"
                    SelectedIndex="2"
                    AutomationProperties.Name="{local:Loc Key=TreeDepthAutomationName}">
            <ComboBoxItem Content="0"/>
            <ComboBoxItem Content="1"/>
            <ComboBoxItem Content="2"/>
            <ComboBoxItem Content="3"/>
            <ComboBoxItem Content="4"/>
          </ComboBox>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="2" Margin="8" MinHeight="0" ClipToBounds="True">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*" MinWidth="250"/>
        <ColumnDefinition Width="5"/>
        <ColumnDefinition Width="7*" MinWidth="330"/>
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TreeHeading"
                   Text="{local:Loc Key=AccessibilityTree}"
                   FontWeight="SemiBold"
                   Margin="2,0,0,6"/>
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="1">
          <TreeView x:Name="NodeTree"
                    Padding="4"
                    SelectedItemChanged="NodeTree_SelectedItemChanged">
            <TreeView.Resources>
              <HierarchicalDataTemplate DataType="{x:Type models:AccessibilityNode}" ItemsSource="{Binding Children}">
                <StackPanel Orientation="Horizontal" Margin="0,1">
                  <TextBlock FontWeight="SemiBold" Text="{Binding ControlType}"/>
                  <TextBlock Text=" — "/>
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </HierarchicalDataTemplate>
            </TreeView.Resources>
          </TreeView>
        </Border>
      </Grid>

      <GridSplitter Grid.Column="1"
                    Width="5"
                    Margin="4,0"
                    Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                    HorizontalAlignment="Stretch"/>

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{local:Loc Key=Properties}"
                   FontWeight="SemiBold"
                   Margin="2,0,0,6"/>
        <Border Grid.Row="1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="1">
          <Border.Resources>
            <Style x:Key="WrappingCellText" TargetType="TextBlock">
              <Setter Property="TextWrapping" Value="Wrap"/>
              <Setter Property="VerticalAlignment" Value="Top"/>
              <Setter Property="Padding" Value="5,3"/>
            </Style>
            <Style x:Key="PropertyDataGrid" TargetType="DataGrid">
              <Setter Property="AutoGenerateColumns" Value="False"/>
              <Setter Property="IsReadOnly" Value="True"/>
              <Setter Property="CanUserAddRows" Value="False"/>
              <Setter Property="HeadersVisibility" Value="Column"/>
              <Setter Property="GridLinesVisibility" Value="Horizontal"/>
              <Setter Property="RowHeaderWidth" Value="0"/>
              <Setter Property="BorderThickness" Value="0"/>
              <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
              <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            </Style>
          </Border.Resources>

          <TabControl x:Name="ApiTabControl"
                      Padding="0"
                      BorderThickness="0"
                      SelectionChanged="ApiTabControl_SelectionChanged">
            <TabItem Header="UIA">
              <DataGrid x:Name="UiaPropertyGrid" Style="{StaticResource PropertyDataGrid}">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="{local:Loc Key=Section}" Width="105">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate><TextBlock Style="{StaticResource WrappingCellText}" Text="{Binding Group}"/></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="{local:Loc Key=Property}" Width="145">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate><TextBlock Style="{StaticResource WrappingCellText}" Text="{Binding Name}"/></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="{local:Loc Key=Value}" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate><TextBlock Style="{StaticResource WrappingCellText}" Text="{Binding Value}"/></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>

            <TabItem Header="MSAA">
              <DataGrid x:Name="MsaaPropertyGrid" Style="{StaticResource PropertyDataGrid}">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="{local:Loc Key=Property}" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate><TextBlock Style="{StaticResource WrappingCellText}" Text="{Binding Name}"/></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="{local:Loc Key=Value}" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate><TextBlock Style="{StaticResource WrappingCellText}" Text="{Binding Value}"/></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>

            <TabItem Header="IAccessible2">
              <DataGrid x:Name="Ia2PropertyGrid" Style="{StaticResource PropertyDataGrid}">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="{local:Loc Key=Property}" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate><TextBlock Style="{StaticResource WrappingCellText}" Text="{Binding Name}"/></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="{local:Loc Key=Value}" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate><TextBlock Style="{StaticResource WrappingCellText}" Text="{Binding Value}"/></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </TabItem>
          </TabControl>
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Row="3"
            BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
            BorderThickness="0,1,0,0"
            Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
            Padding="6,2">
      <Grid MinHeight="20">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MinWidth="0"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText"
                   Grid.Column="0"
                   Text="{local:Loc Key=Ready}"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        <TextBlock Grid.Column="1"
                   Margin="12,0,0,0"
                   Text="UIA · MSAA · IAccessible2"
                   VerticalAlignment="Center"
                   TextWrapping="NoWrap"/>
      </Grid>
    </Border>
  </Grid>
</Window>
