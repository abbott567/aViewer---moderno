<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>AViewer.Moderno</AssemblyName>
    <RootNamespace>AViewer.App</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AViewer.Core\AViewer.Core.csproj" />
    <None Update="HelpMenuLinks.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Ignore obsolete files that may remain when a newer archive is extracted over an older checkout. -->
    <Compile Remove="AccessibilityVisualPalette.cs" />
    <Compile Remove="HelpMenuLink.cs" />
  </ItemGroup>
</Project>
